# Server
NODE_ENV=development
PORT=4000

# MongoDB (local dev instance)
MONGODB_URI=mongodb://127.0.0.1:27017/care_guide_test

# Auth - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# Security
BCRYPT_COST=12

# Seed admin (development only - used by `npm run seed`)
SEED_ADMIN_EMAIL=admin@careguide.dev
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=Portal Administrator
